{{ website.bodyTopHTML|raw }}

<div class="container">
    <header class="py-md-4">
        <div class="row align-items-center fw-bold">
            <div class="col-12 col-lg-4 text-center text-lg-start">
                <a class="text-decoration-none" href="/">
                    <!-- add website.logo -->
                    {% if website.logo %}
                        <img class="img img-fluid" src="/media/{{ website.logo.originalName }}" alt="{{ website.title|raw }}" title="{{ website.title|raw }}">
                    {% else %}
                        {{ website.title|raw }}
                    {% endif %}
                </a>
            </div>
            <div class="col-12 col-lg-8 text-center text-lg-end">
                {% for widget in website.instance.widgets %}
                    {% if widget.templateCode.value == 'headerBanner' and widget.status == 1 and widget.content is not null %}
                        {{ widget.content|raw }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </header>
</div>

<nav class="navbar navbar-expand-lg bg-body-tertiary rounded" aria-label="">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarsExample10" aria-controls="navbarsExample10" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-md-center" id="navbarsExample10">
            <ul class="navbar-nav">
                {% for menu in menus %}
                    <li class="nav-item"><a class="nav-link" aria-current="page" href="{{ menu.slug }}">{{ menu.title|raw }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
</nav>

